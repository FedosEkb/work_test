{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {//Plugin: C/C++(cpptools)
            "name": "(gdb) Запустить",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Debug/${workspaceFolderBasename}.elf",
            "args": [
                 "--i_file",
                 "test.txt",
                    ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Direct GDB commands",
                    "text": "set target-async on",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod hanging bug",
                    "text": "set debuginfod urls none", // ИСПРАВЛЕНО: отключает зависание сети в GDB
                    "ignoreFailures": true
                }
            ]
        },

        {//Plugin: Native Debug
            "type": "gdb",
            "request": "launch",
            "name": "GDB: Launch Program",
            "target": "${workspaceFolder}/Debug/${workspaceFolderBasename}.elf",
            "arguments": "",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "valuesFormatting": "prettyPrinters",
        },

    ]
}